from math import*
a = float(input("hãy nhập hệ số a: "))
while a==0:
    a =float(input("Bạn hãy nhập lại a phải khác 0: "))
b = float(input("hãy nhập hệ số b: "))
c = float(input("Hãy nhập hệ số c: "))
denta=b**2-4*a*c
if denta>0:
    x1 = (-b+(sqrt(denta)))/2*a
    x2 = (-b-(sqrt(denta)))/2*a
    print("phương trình có hai nghiệm phân biệt là","x1=",x1,"x2=",x2)
elif denta==0:
    print(f"Phương trình có nghiệm kép là {-b/2*a}")
else:
    print("phương trình vô nghiệm")